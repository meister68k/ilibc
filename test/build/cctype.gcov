     5242:   21:[[nodiscard]] constexpr bool isupper(int c) noexcept { return ilibc::detail::in_range(c, 'A', 'Z'); }
     5164:   22:[[nodiscard]] constexpr bool islower(int c) noexcept { return ilibc::detail::in_range(c, 'a', 'z'); }
     3851:   23:[[nodiscard]] constexpr bool isdigit(int c) noexcept { return ilibc::detail::in_range(c, '0', '9'); }
        -:   24:
     2668:   25:[[nodiscard]] constexpr bool isalpha(int c) noexcept { return isupper(c) || islower(c); }
     1381:   26:[[nodiscard]] constexpr bool isalnum(int c) noexcept { return isalpha(c) || isdigit(c); }
        -:   27:
     1287:   28:[[nodiscard]] constexpr bool isxdigit(int c) noexcept {
     1287:   29:    return isdigit(c) || ilibc::detail::in_range(c, 'A', 'F') || ilibc::detail::in_range(c, 'a', 'f');
