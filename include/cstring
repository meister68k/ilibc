// cstring
// The 18 <cstring> functions of ILIBC-STR-001 sections 2.1-2.2, adapted to
// the namespace/asm-label macros of ILIBC-HDR-001 section 3.4.
// The 13 string functions are constexpr inline (section 5). The five mem*
// functions are declared here with fixed C link names and defined in
// src/string/*.cpp (section 7.1); they are not constexpr for now because
// C++23 constant expressions cannot convert from void* (section 6.2 case (a)).
#pragma once

#include <ilibc/config.hpp>
#include <ilibc/string_mem.hpp>
#include <cstddef>
#include <cstdint>

ILIBC_NS_BEGIN

// ---------------------------------------------------------------- mem* (ST-01..ST-05)

// Copy the first n bytes of s2 to s1; returns s1 (overlap is undefined) (5.1)
ILIBC_NONNULL void *memcpy(void *s1, const void *s2, std::size_t n) noexcept
    ILIBC_ASM_LABEL("memcpy");

// Copy the first n bytes of s2 to s1, overlap-safe; returns s1 (5.1)
ILIBC_NONNULL void *memmove(void *s1, const void *s2, std::size_t n) noexcept
    ILIBC_ASM_LABEL("memmove");

// Compare the first n bytes as unsigned char; byte difference (4.4, 5.1)
[[nodiscard]] ILIBC_NONNULL int memcmp(const void *s1, const void *s2, std::size_t n) noexcept
    ILIBC_ASM_LABEL("memcmp");

// Set the first n bytes to (unsigned char)c; returns s (5.1)
ILIBC_NONNULL void *memset(void *s, int c, std::size_t n) noexcept
    ILIBC_ASM_LABEL("memset");

// Find the first byte equal to (unsigned char)c in the first n bytes; returns
// its address or nullptr (n == 0 included) (5.1 ST-04). The two overloads are
// inline wrappers over memchr_base, which carries the C link name "memchr"
// (7.2). The argument check lives in the base body (4.7).
[[nodiscard]] ILIBC_NONNULL inline const void *memchr(const void *s, int c,
                                                      std::size_t n) noexcept {
    return ilibc::detail::memchr_base(s, c, n);
}
[[nodiscard]] ILIBC_NONNULL inline void *memchr(void *s, int c, std::size_t n) noexcept {
    return ilibc::detail::memchr_base(s, c, n);
}

// ------------------------------------------------- copy and concatenate (ST-06..ST-09)

// Copy s2 including its terminator to s1; returns s1 (overlap is undefined) (5.2)
ILIBC_NONNULL constexpr char *strcpy(char *s1, const char *s2) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    std::size_t i = 0;
    while ((s1[i] = s2[i]) != '\0') { ++i; }        // copy up to and incl. terminator
    return s1;
}

// Copy at most n characters of s2 to s1, padding with '\0'; returns s1.
// Writes exactly n bytes: s1 is NOT terminated when s2 is n+ characters (5.2).
ILIBC_NONNULL constexpr char *strncpy(char *s1, const char *s2, std::size_t n) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    std::size_t i = 0;
    while (i < n && s2[i] != '\0') { s1[i] = s2[i]; ++i; }   // copy characters
    while (i < n) { s1[i] = '\0'; ++i; }                     // pad the remainder
    return s1;
}

// Append s2 (including its terminator) to s1; returns s1 (overlap undefined) (5.2)
ILIBC_NONNULL constexpr char *strcat(char *s1, const char *s2) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    std::size_t i = 0;
    while (s1[i] != '\0') { ++i; }                   // find the end of s1
    std::size_t j = 0;
    while ((s1[i + j] = s2[j]) != '\0') { ++j; }     // copy up to and incl. terminator
    return s1;
}

// Append at most n characters of s2 to s1, then always terminate; returns s1 (5.2)
ILIBC_NONNULL constexpr char *strncat(char *s1, const char *s2, std::size_t n) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    std::size_t i = 0;
    while (s1[i] != '\0') { ++i; }                   // find the end of s1
    std::size_t j = 0;
    while (j < n && s2[j] != '\0') { s1[i + j] = s2[j]; ++j; }
    s1[i + j] = '\0';                                // terminator is written always
    return s1;
}

// --------------------------------------------------------- compare (ST-10, ST-11)

// Compare two strings as unsigned char; byte difference (4.4, 5.3)
[[nodiscard]] ILIBC_NONNULL constexpr int strcmp(const char *s1, const char *s2) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    std::size_t i = 0;
    while (s1[i] != '\0' && s1[i] == s2[i]) { ++i; }
    return static_cast<int>(static_cast<unsigned char>(s1[i]))
         - static_cast<int>(static_cast<unsigned char>(s2[i]));
}

// Compare at most n characters; stops at a terminator; byte difference (4.4, 5.3)
[[nodiscard]] ILIBC_NONNULL constexpr int strncmp(const char *s1, const char *s2,
                                                   std::size_t n) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    for (std::size_t i = 0; i < n; ++i) {
        const unsigned char a = static_cast<unsigned char>(s1[i]);
        const unsigned char b = static_cast<unsigned char>(s2[i]);
        if (a != b) { return static_cast<int>(a) - static_cast<int>(b); }
        if (a == '\0') { return 0; }
    }
    return 0;
}

// ------------------------------------------------------------- search (ST-12..ST-17)

// Find the first character equal to (char)c, the terminator included;
// returns its address or nullptr (5.4)
[[nodiscard]] ILIBC_NONNULL constexpr const char *strchr(const char *s, int c) noexcept {
    ILIBC_ASSERT(s != nullptr);
    const char ch = static_cast<char>(c);
    for (;; ++s) {
        if (*s == ch) { return s; }                  // equality is tested first
        if (*s == '\0') { return nullptr; }
    }
}
[[nodiscard]] ILIBC_NONNULL constexpr char *strchr(char *s, int c) noexcept {
    return const_cast<char *>(strchr(static_cast<const char *>(s), c));
}

// Find the last character equal to (char)c, the terminator included;
// returns its address or nullptr (5.4)
[[nodiscard]] ILIBC_NONNULL constexpr const char *strrchr(const char *s, int c) noexcept {
    ILIBC_ASSERT(s != nullptr);
    const char ch = static_cast<char>(c);
    const char *last = nullptr;
    for (;; ++s) {
        if (*s == ch) { last = s; }
        if (*s == '\0') { return last; }
    }
}
[[nodiscard]] ILIBC_NONNULL constexpr char *strrchr(char *s, int c) noexcept {
    return const_cast<char *>(strrchr(static_cast<const char *>(s), c));
}

// Find the first occurrence of string s2 in s1; returns its address, or s1
// itself when s2 is empty, or nullptr (5.4)
[[nodiscard]] ILIBC_NONNULL constexpr const char *strstr(const char *s1, const char *s2) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    if (*s2 == '\0') { return s1; }
    for (; *s1 != '\0'; ++s1) {
        std::size_t i = 0;
        while (s2[i] != '\0' && s1[i] == s2[i]) { ++i; }
        if (s2[i] == '\0') { return s1; }            // s2 matched to the end
    }
    return nullptr;
}
[[nodiscard]] ILIBC_NONNULL constexpr char *strstr(char *s1, const char *s2) noexcept {
    return const_cast<char *>(strstr(static_cast<const char *>(s1), s2));
}

// Length of the leading run of characters that all occur in s2; 0 if s2 is
// empty (5.4)
[[nodiscard]] ILIBC_NONNULL constexpr std::size_t strspn(const char *s1, const char *s2) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    std::size_t n = 0;
    while (s1[n] != '\0') {
        const char *p = s2;
        while (*p != '\0' && *p != s1[n]) { ++p; }   // look s1[n] up in s2
        if (*p == '\0') { break; }                   // not found: stop
        ++n;
    }
    return n;
}

// Length of the leading run of characters that do not occur in s2; equals
// strlen(s1) when s2 is empty (5.4)
[[nodiscard]] ILIBC_NONNULL constexpr std::size_t strcspn(const char *s1, const char *s2) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    std::size_t n = 0;
    while (s1[n] != '\0') {
        const char *p = s2;
        while (*p != '\0' && *p != s1[n]) { ++p; }
        if (*p != '\0') { break; }                   // found: stop
        ++n;
    }
    return n;
}

// Find the first character of s1 that occurs in s2 (the terminator excluded);
// returns its address or nullptr (5.4)
[[nodiscard]] ILIBC_NONNULL constexpr const char *strpbrk(const char *s1, const char *s2) noexcept {
    ILIBC_ASSERT(s1 != nullptr);
    ILIBC_ASSERT(s2 != nullptr);
    for (; *s1 != '\0'; ++s1) {
        for (const char *p = s2; *p != '\0'; ++p) {
            if (*p == *s1) { return s1; }
        }
    }
    return nullptr;
}
[[nodiscard]] ILIBC_NONNULL constexpr char *strpbrk(char *s1, const char *s2) noexcept {
    return const_cast<char *>(strpbrk(static_cast<const char *>(s1), s2));
}

// ------------------------------------------------------------------- strlen (ST-18)

// Number of characters before the terminator (5.5)
[[nodiscard]] ILIBC_NONNULL constexpr std::size_t strlen(const char *s) noexcept {
    ILIBC_ASSERT(s != nullptr);
    std::size_t n = 0;
    while (s[n] != '\0') { ++n; }
    return n;
}

ILIBC_NS_END
